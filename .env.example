# Copy to .env on the host. Never commit .env.
NODE_ENV=production
PORT=3000
PORTAL_NAME=My Portal
PORTAL_URL=https://portal.example.com
PORTAL_ADMIN_EMAIL=admin@example.com
DATABASE_URL=postgres://portal:change-me@db:5432/portal
DATABASE_SSL=false
# When DATABASE_SSL=true, verify TLS certificates unless set to false (local/dev only).
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
PORTAL_DB_PASSWORD=change-this-password
SESSION_SECRET=generate-a-long-random-value
CONFIG_ENCRYPTION_KEY=generate-a-32-byte-secret
PORTAL_ADMIN_USERNAME=admin
# scrypt hash — see AGENTS.md for generation
PORTAL_ADMIN_PASSWORD_HASH=
PORTAL_ADMIN_PASSWORD_SALT=

# Cookie / proxy (production defaults: secure cookies + trust proxy)
# COOKIE_SECURE=true
TRUST_PROXY=1
# AUTH_RATE_LIMIT_MAX=30

# Optional Discord portal sign-in
AUTH_DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://portal.example.com/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=

# Optional media providers; leave unused providers blank
EMBY_URL=
EMBY_DIRECT_URL=
EMBY_API_KEY=
EMBY_TEMPLATE_USER_ID=
EMBY_ROLE_IDS=
SILO_URL=
SILO_API_KEY=
SILO_ROLE_IDS=
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_ROLE_IDS=
PLEX_URL=
PLEX_TOKEN=
PLEX_ROLE_IDS=

# Optional Seerr integration
SEERR_ENABLED=false
SEERR_URL=
SEERR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
# Optional legacy fallback. For multiple Radarr/Sonarr/Sportarr instances,
# configure named instances in Administration -> Seerr -> Radarr & Sonarr.
# Request permissions are controlled in Administration -> Seerr -> Portal Permissions.
TMDB_API_KEY=

# Optional comic library backend. Kavita provides the comic web reader and OPDS/OPDS-PS feed.
KAVITA_URL=
KAVITA_API_KEY=
# Or paste the complete per-user URL from Kavita Preferences -> OPDS.
KAVITA_OPDS_URL=
